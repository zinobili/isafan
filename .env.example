# Copy to .env and adjust as needed. All vars are optional; defaults shown.

# --- Server ---
ISAFAN_HOST=0.0.0.0
ISAFAN_PORT=8000
# Address players use to reach this server (LAN IP or tunnel URL). Leave blank
# and the server auto-detects this machine's LAN IP for the join link / QR; the
# host screen offers alternates if the first one can't be reached. Set it
# explicitly to pin a tunnel URL. Only affects the join link, not how clients
# connect.
ISAFAN_PUBLIC_URL=
ISAFAN_DATA_DIR=data
ISAFAN_STORAGE=local
ISAFAN_CODE_LENGTH=4
ISAFAN_MAX_PLAYERS=10
ISAFAN_STATIC_DIR=web/dist
ISAFAN_DEV_CORS_ORIGIN=http://localhost:5173
ISAFAN_GAME_TTL=86400

# --- Audio (Phase 2) ---
# ffmpeg is bundled via the imageio-ffmpeg dependency; set this only to override.
ISAFAN_FFMPEG=
ISAFAN_AUDIO_SR=16000
ISAFAN_MAX_CLIP_SECONDS=45
ISAFAN_MAX_UPLOAD_BYTES=26214400
