# Copy to .env and adjust as needed. All vars are optional; defaults shown.

# --- Server ---
ISAFAN_HOST=0.0.0.0
ISAFAN_PORT=8000
# Address players use to reach this server (LAN IP or tunnel URL). Leave blank to
# use whatever origin the host screen was opened with. Only affects the join
# link / QR code, not how clients connect.
ISAFAN_PUBLIC_URL=
ISAFAN_DATA_DIR=data
ISAFAN_STORAGE=local
ISAFAN_CODE_LENGTH=4
ISAFAN_MAX_PLAYERS=10
ISAFAN_STATIC_DIR=web/dist
ISAFAN_DEV_CORS_ORIGIN=http://localhost:5173
ISAFAN_GAME_TTL=86400

# --- Admin portal (Phase 6 — not wired up yet) ---
ISAFAN_ADMIN_USER=admin
ISAFAN_ADMIN_PASSWORD_HASH=
