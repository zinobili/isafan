# Copy to .env and adjust as needed. All vars are optional; defaults shown.

# --- Server ---
ISAFAN_HOST=0.0.0.0
ISAFAN_PORT=8000
# Address players use to reach this server (LAN IP or tunnel URL). Leave blank
# and the server auto-detects this machine's LAN IP for the join link / QR; the
# host screen offers alternates if the first one can't be reached. Set it
# explicitly to pin a tunnel URL. Only affects the join link, not how clients
# connect.
ISAFAN_PUBLIC_URL=
ISAFAN_DATA_DIR=data
# Where clips + game.json + the song library live: "local" (ISAFAN_DATA_DIR on
# disk) or "s3" (any S3-compatible service — see the ISAFAN_S3_* group below).
ISAFAN_STORAGE=local
ISAFAN_CODE_LENGTH=4
ISAFAN_MAX_PLAYERS=10
ISAFAN_STATIC_DIR=web/dist
ISAFAN_DEV_CORS_ORIGIN=http://localhost:5173
# Retention window, in seconds: a game's stored folder (audio + game.json) is
# purged once it's older than this. Default 86400 = 24 h. Also drives the
# "kept up to N hours" line players see before recording. 0 disables purging.
ISAFAN_GAME_TTL=86400
# How often the retention sweep deletes games older than ISAFAN_GAME_TTL.
# Runs once on startup, then on this interval. 0 turns the sweep off.
ISAFAN_PURGE_INTERVAL=3600

# Per-client-IP cap on creating games (POST /api/solo + the WebSocket "create"
# verb): CREATE_RATE games as a burst, refilling to full over CREATE_RATE_WINDOW
# seconds. 0 disables the limit.
ISAFAN_CREATE_RATE=10
ISAFAN_CREATE_RATE_WINDOW=60

# Serve HTTPS so phones on the LAN can record in-page (see README). Point these
# at an mkcert pair; leave blank for plain HTTP + the file-input fallback.
ISAFAN_SSL_CERT=
ISAFAN_SSL_KEY=

# --- Admin portal (Phase 6) ---
# The /admin portal is OFF until both USER and PASSWORD_HASH are set. Generate
# the hash line with:  python -m server.admin.hashpw
# It prints  ISAFAN_ADMIN_PASSWORD_HASH='scrypt$...'  — paste that whole line
# here, keeping the single quotes (the hash contains '$').
ISAFAN_ADMIN_USER=
ISAFAN_ADMIN_PASSWORD_HASH=
# Cookie-signing key. Leave blank to derive one from the password hash (so
# changing the password logs everyone out); set it to keep sessions across a
# password change, or to share a key across instances.
ISAFAN_ADMIN_SECRET=
# The session cookie is HTTPS-only by default. Set to 1 ONLY for local plain-http
# testing (ignored when ISAFAN_SSL_CERT/KEY are set — then it's always secure).
ISAFAN_ADMIN_INSECURE=0
ISAFAN_ADMIN_LOGIN_RATE=5          # failed logins per IP before a cool-off
ISAFAN_ADMIN_LOGIN_WINDOW=900      # seconds for that budget to refill
ISAFAN_ADMIN_SESSION_TTL=43200     # admin session lifetime (12 h)

# --- Audio (Phase 2) ---
# ffmpeg is bundled via the imageio-ffmpeg dependency; set this only to override.
ISAFAN_FFMPEG=
ISAFAN_AUDIO_SR=16000
ISAFAN_MAX_CLIP_SECONDS=45
# Separate, usually longer cap for admin song-library reference clips.
ISAFAN_MAX_SONG_SECONDS=60
ISAFAN_MAX_UPLOAD_BYTES=26214400

# --- Object storage (Phase 7; only read when ISAFAN_STORAGE=s3) ---
ISAFAN_S3_BUCKET=
ISAFAN_S3_REGION=              # e.g. us-east-1, or "auto" for Cloudflare R2
ISAFAN_S3_ENDPOINT=            # custom endpoint URL for R2 / MinIO; blank for AWS
ISAFAN_S3_PREFIX=              # optional key prefix, e.g. "prod"
# Omit both to use the ambient AWS credential chain (IAM role / ~/.aws).
ISAFAN_S3_ACCESS_KEY=
ISAFAN_S3_SECRET_KEY=
